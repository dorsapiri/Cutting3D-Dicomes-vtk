<Window x:Class="Cutting3D.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vtk="clr-namespace:Kitware.VTK;assembly=Kitware.VTK"
        xmlns:local="clr-namespace:Cutting3D"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <WindowsFormsHost Loaded="WindowsFormsHost_Loaded" KeyDown="MainWindow_KeyDown" KeyUp="MainWindow_KeyUp">
            <vtk:RenderWindowControl x:Name="renderWindowControl"/>
        </WindowsFormsHost>
    </Grid>
</Window>
